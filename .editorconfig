# Editor settings shared by IntelliJ and other editors (Java formatting itself is Spotless' job)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yaml,yml,json,tf,tfvars,hcl}]
indent_size = 2

[pom.xml]
indent_style = tab

[*.md]
# Two trailing spaces are a line break in Markdown
trim_trailing_whitespace = false

[*.cmd]
end_of_line = crlf
